      "dir": "notes/permanent",
      "template": "templates/permanent.md",
      "frontmatter": [
        "id",
        "title",
        "type",
        "created",
        "tags",
        "updated"
      ]
    },
    "project": {
      "dir": "notes/project",
      "template": "templates/project.md",
      "frontmatter": [
        "id",
        "title",
        "type",
        "project",
        "created",
        "tags",
        "updated"
      ]
    }
